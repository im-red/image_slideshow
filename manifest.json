{
    "manifest_version": 3,
    "name": "Image Slideshow",
    "version": "0.1",
    "background": {
        "service_worker": "background.ts"
    },
    "action": {
        "default_title": "Start Slideshow",
        "default_icon": {
            "128": "icon.png"
        }
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+S",
                "mac": "Alt+S"
            },
            "description": "Start Slideshow"
        }
    },
    "permissions": [
        "downloads",
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "options_page": "options/options.html",
    "content_scripts": [
        {
            "matches": [
                "<all_urls>",
                "file:///*"
            ],
            "js": [
                "content-scripts/watcher.ts"
            ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "assets/*",
                "content-scripts/*"
            ],
            "matches": [
                "<all_urls>",
                "file:///*"
            ]
        }
    ]
}